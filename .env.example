# Leave N8N_BASE_URL unset to run Dunnly against the built-in mock backend
# (lib/store.ts) — this is the default and requires nothing below. Set it to
# cut over to a real N8N instance. See n8n/README.md for full setup steps.

# Base URL of your N8N instance, no trailing slash. Unset = mock mode.
# N8N_BASE_URL=https://your-instance.app.n8n.cloud

# Shared secret for the Header Auth credential on every Dunnly webhook node
# in N8N (header name: x-dunnly-secret). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# N8N_WEBHOOK_SECRET=

# /webhook for production workflows, /webhook-test when testing against the
# N8N editor's "Listen for test event" mode.
# N8N_WEBHOOK_PREFIX=/webhook

# Proxy-side abort timeout in ms. Keep below each route's `maxDuration`.
# N8N_TIMEOUT_MS=45000

# Whether drafted messages send without manual approval. Read server-side
# only — never exposed to the browser as an env var.
AUTO_SEND=false

# --- Twilio WhatsApp sandbox (optional; used for local smoke / n8n send) ---
# Subaccount SID + auth token from Twilio Console (or .twilio-dunnly-subaccount.json).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# Sandbox From number (default Twilio sandbox):
# TWILIO_WA_FROM=whatsapp:+14155238886
# Content template SID (HX…) — sandbox Order Notifications or your approved template:
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your phone joined to the sandbox (whatsapp:+E164). Only INV-24245 (Piyush Tater Demo Co) uses this.
# ADMIN_PHONE=whatsapp:+15551234567

# WhatsApp send mode for dunnly-send: off | dryrun | live (default live for E2E).
# WA_MODE=live

# --- OpenRouter (optional local override for evals) ---
# Prefer n8n saved credential "OpenRouter account" via workflow dunnly-eval-llm
# (`npm run push:eval-llm` then `npm run eval:wa-draft`). Set this only if you
# want to call OpenRouter directly from the machine running evals.
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Power Automate email (n8n HOST env only) ---
# PA flow "Dunnly AR Send Email" → Gmail connector. See n8n/docs/power-automate-email-gmail.md
# PA_EMAIL_WEBHOOK_URL=<HTTP POST URL from PA trigger>

# --- Microsoft Graph email: NOT USED. New tenant has no Entra app. ---
# Live email is Power Automate → Gmail. Do not create MS_* until Graph is revived.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER_UPN=

# --- Microsoft Teams (identifiers — Graph path only; unused by PA webhooks) ---
# Channel / team GUIDs from the old tenant are invalid after the account move.
# Re-verify against team "Dunnly" if anyone revives Graph Teams posting.
# Webhook URLs (Power Automate) live on the n8n HOST env only — never commit secrets/URLs here.
# TEAMS_TEAM_ID=<teams team guid>
# TEAMS_CHANNEL_ESCALATIONS=<channel id @thread.tacv2>
# TEAMS_CHANNEL_ALERTS=<channel id @thread.tacv2>
# TEAMS_CHANNEL_DISPUTES=<channel id @thread.tacv2>
# TEAMS_CHANNEL_PAYMENTS=<channel id @thread.tacv2>
# TEAMS_CHANNEL_ID=<same as TEAMS_CHANNEL_ESCALATIONS>
# TEAMS_CHANNEL_NAME=ar-escalations
#
# n8n host env (not Next.js):
# TEAMS_WEBHOOK_ESCALATIONS=<Power Automate URL → #ar-escalations>
# TEAMS_WEBHOOK_DISPUTES=<Power Automate URL → #ar-disputes>
# TEAMS_WEBHOOK_PAYMENTS=<Power Automate URL → #ar-payments>
# TEAMS_WEBHOOK_ALERTS=<Power Automate URL → #ar-alerts>
# TEAMS_INCOMING_WEBHOOK_URL=<back-compat alias for TEAMS_WEBHOOK_ESCALATIONS>
#
# Optional: n8n host pushes ledger to dashboard after sheet sync (SSE)
# DASHBOARD_NOTIFY_URL=https://your-app.vercel.app/api/invoices/notify
# LEDGER_NOTIFY_SECRET=  # optional; defaults to N8N_WEBHOOK_SECRET
#
# Smoke-test all four webhooks after setup:
#   node scripts/probe-teams-webhooks.js

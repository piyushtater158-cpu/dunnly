    {
      "id": "code-match-email-1",
      "name": "Match email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $('Parse email').item.json;\nconst SELF = 'piyushtater158@gmail.com';\nfunction normEmail(raw) {\n  const s = String(raw || '').trim().toLowerCase();\n  const m = s.match(/<([^>]+)>/);\n  return (m ? m[1] : s).trim();\n}\nconst from = normEmail(meta.fromEmail);\nif (!from || from === normEmail(SELF)) {\n  return [{ json: { ...meta, matchCount: 0, attachInvoiceId: '', matchReason: 'ignored_self', logStatus: 'pending' } }];\n}\nconst subjectInv = (meta.subject || '').match(/INV-\\d+/i);\nconst subjectId = subjectInv ? subjectInv[0].toUpperCase() : '';\nconst rows = $input.all().map(({ json: r }) => ({\n  id: String(r.id || ''),\n  email: normEmail(r.email),\n  stage: String(r.stage || '').toLowerCase(),\n  emailSentAt: String(r.emailSentAt || '').trim(),\n}));\nconst openEligible = (r) =>\n  (r.stage === 'sent' || r.stage === 'replied') &&\n  (String(r.emailSentAt || '').trim() !== '' || r.stage === 'sent');\nconst matches = rows.filter((r) => r.email && r.email === from && openEligible(r));\nlet attachInvoiceId = '';\nlet matchReason = 'unmatched';\nlet matchCount = 0;\nlet matchIds = [];\nif (matches.length === 1) {\n  matchCount = 1;\n  matchIds = [matches[0].id];\n  if (subjectId && subjectId !== matches[0].id.toUpperCase()) {\n    matchReason = 'ambiguous_subject_mismatch';\n  } else {\n    attachInvoiceId = matches[0].id;\n    matchReason = 'attached';\n  }\n} else if (matches.length > 1) {\n  matchIds = matches.map((m) => m.id);\n  matchCount = matches.length;\n  if (subjectId) {\n    const subjectMatches = matches.filter((m) => m.id.toUpperCase() === subjectId);\n    if (subjectMatches.length === 1) {\n      attachInvoiceId = subjectMatches[0].id;\n      matchReason = 'attached';\n      matchCount = 1;\n      matchIds = [subjectMatches[0].id];\n    } else {\n      matchReason = 'ambiguous_multiple';\n    }\n  } else {\n    matchReason = 'ambiguous_multiple';\n  }\n}\nreturn [{ json: {\n  ...meta,\n  matchIds,\n  matchCount,\n  attachInvoiceId,\n  matchReason,\n  logStatus: attachInvoiceId ? 'attached' : 'pending',\n  attachedInvoiceId: attachInvoiceId,\n  body: meta.bodyPlain,\n  kind: 'reply',\n  from: meta.fromEmail,\n  sid: meta.messageId,\n} }];"
      }
    },
    {
      "id": "if-email-unique-1",
      "name": "Unique match?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1040, 0],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.attachInvoiceId ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },

    {
      "id": "code-parse-email-1",
      "name": "Parse email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || $json;\nreturn {\n  json: {\n    messageId: String(b.messageId || b.id || ('EM' + Date.now())),\n    fromEmail: String(b.fromEmail || b.from || ''),\n    subject: String(b.subject || ''),\n    bodyPlain: String(b.bodyPlain || b.body || '').slice(0, 2000),\n    receivedAt: String(b.receivedAt || new Date().toISOString()),\n    now: new Date().toISOString(),\n  },\n};"
      }
    },
    {
      "id": "sheets-read-inv-email-1",
      "name": "Read invoices",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [520, 0],
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "1qk-kY0gwgDU9Sef-lvDLRZEe-W-m1AUZtm4inJb9ph0",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "invoices",
          "mode": "name"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "XTaQHKonHKfxw3GX",
          "name": "Google Sheets account"
        }
